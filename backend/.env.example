PORT=4000
NODE_ENV=development

# PostgreSQL - one shared database, one schema per organization (see src/db.js)
PGHOST=localhost
PGPORT=5432
PGDATABASE=crm_hrm
PGUSER=localhost
PGPASSWORD=GrowInch123
# Max connections in the shared pool - all organizations share this one pool's budget.
PGPOOL_MAX=20

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Gmail SMTP (for forgot/reset password emails) - use a Gmail App Password, not your regular password
SMTP_USER=
SMTP_PASS=
